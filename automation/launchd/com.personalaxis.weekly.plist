<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personalaxis.weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/venv/bin/python</string>
        <string>-m</string>
        <string>orchestration.main</string>
        <string>review-context</string>
        <string>--type</string>
        <string>weekly</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/PersonalAxis</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>7</integer> <!-- Sunday -->
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/path/to/PersonalAxis/logs/weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/PersonalAxis/logs/weekly.error.log</string>
</dict>
</plist>
